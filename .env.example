# Copy to .env and fill in:  cp .env.example .env
# .env is in .gitignore — never commit real keys.

# Kaggle API token (https://www.kaggle.com/settings -> API -> "Create New Token")
# Open the downloaded kaggle.json and copy "username" and "key" here.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Where the raw images are downloaded to
DATA_DIR=data/raw
